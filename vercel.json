{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        { "type": "host", "value": "viscarekids.com" },
        { "type": "header", "key": "x-vercel-ip-country", "value": "IT" }
      ],
      "missing": [
        { "type": "query", "key": "nogeo" }
      ],
      "destination": "https://it.viscarekids.com/:path*",
      "permanent": false
    },
    {
      "source": "/:path*",
      "has": [
        { "type": "host", "value": "www.viscarekids.com" },
        { "type": "header", "key": "x-vercel-ip-country", "value": "IT" }
      ],
      "missing": [
        { "type": "query", "key": "nogeo" }
      ],
      "destination": "https://it.viscarekids.com/:path*",
      "permanent": false
    }
  ]
}
